# --- PostgreSQL (MLflow backend store)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=mlflow_db

# --- MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:<your-postgres-password>@postgres:5432/mlflow_db
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# --- MinIO (S3-compatible artifact store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<your-minio-password>
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=<your-minio-password>
MLFLOW_BUCKET_NAME=mlflow

# --- Model configuration
MODEL_NAME=titanic-survivor
DATA_PATH=/app/data/raw.csv
MODEL_PATH=/app/data/model.joblib
REPORTS_PATH=/app/reports

# --- Nginx
NGINX_HOST=localhost

# --- DagsHub / DVC (optional, only for dataset versioning)
DAGSHUB_USER=Lalanne0
DAGSHUB_TOKEN=<your-dagshub-token>

# --- LLM / Copilot (optional, mock mode used when LLM_API_KEY is empty)
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=<your-groq-api-key>
LLM_BASE_URL=https://api.groq.com/openai/v1
